# Nginx site config for Meridian Logistics (web VM).
# Deployed to /etc/nginx/sites-available/meridian.conf by deploy_site.sh /
# harden.sh, which substitute WEB_IP and the admin basic-auth path.
# Phase 2: plain HTTP only. Phase 3 appends the 443 server block and the
# 301 redirect. Phase 4 appends rate limiting and security headers.

limit_req_zone $binary_remote_addr zone=api_zone:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=admin_zone:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=conn_zone:10m;

server {
    listen 80 default_server;
    server_name web;

    root /var/www/html;
    index index.html;

    server_tokens off;
    autoindex off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'" always;

    # Phase 3 inserts here:
    # return 301 https://$host$request_uri;

    location / {
        try_files $uri $uri/ =404;
    }

    location /api/ {
        limit_req zone=api_zone burst=10 nodelay;
        limit_conn conn_zone 20;
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        limit_req zone=admin_zone burst=5 nodelay;
        auth_basic "Meridian Admin";
        auth_basic_user_file /etc/nginx/.htpasswd;
        root /var/www/html;
        try_files $uri $uri/ =404;
    }
}
