# E1/E2 BENCHMARK ONLY: identical to meridian-full.conf.template except
# port 80 serves the real site directly instead of 301-redirecting to
# HTTPS. Deployed as a full replacement of
# /etc/nginx/sites-available/meridian.conf by experiments/run_E1.sh and
# run_E2.sh for their "plain HTTP" benchmark runs, then immediately
# swapped back with meridian-full.conf.template so the real hardened
# state (301 redirect, no plaintext content path at all) returns.
#
# Why this exists: a `wrk http://<web>/` against the real hardened config
# only ever measures the 301 redirect's own tiny response (Content-Length
# 162 plus headers), not the real page - confirmed directly: a redirect
# run moved ~336 bytes/request while Apache's equivalent real-page run on
# port 8080 moved ~1978 bytes/request for the same homepage. E1 is
# supposed to compare Apache vs Nginx serving the SAME real content; E2 is
# supposed to compare the cost of adding TLS to the SAME real content.
# Neither question can be answered by benchmarking a redirect. See
# docs/decisions.md.

limit_req_zone $binary_remote_addr zone=api_zone:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=admin_zone:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=conn_zone:10m;

server {
    listen 80 default_server;
    server_name web;
    server_tokens off;
    autoindex off;
    root /var/www/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /api/ {
        limit_req zone=api_zone burst=10 nodelay;
        limit_conn conn_zone 20;
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name web;

    ssl_certificate     /etc/ssl/certs/web.crt;
    ssl_certificate_key /etc/ssl/private/web.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'" always;

    server_tokens off;
    autoindex off;
    root /var/www/html;
    index index.html;

    limit_req_status 429;
    limit_conn_status 429;

    location / {
        try_files $uri $uri/ =404;
    }

    location /api/ {
        limit_req zone=api_zone burst=10 nodelay;
        limit_conn conn_zone 20;
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        limit_req zone=admin_zone burst=5 nodelay;
        auth_basic "Meridian Admin";
        auth_basic_user_file /etc/nginx/.htpasswd;
        root /var/www/html;
        try_files $uri $uri/ =404;
    }
}
