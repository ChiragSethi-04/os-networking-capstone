#!/usr/bin/env bash
# Idempotently ensures web/db/attacker hosts entries exist in /etc/hosts.
# Deployed to /usr/local/bin/ensure_hosts.sh (with WEB_IP/DB_IP/ATT_IP
# substituted from lab/.env) and run at every boot by
# capstone-hosts.service, because cloud-init's own update_etc_hosts module
# re-applies this instance's original `manage_etc_hosts` setting (recorded
# at first launch) on every boot and would otherwise wipe a plain one-time
# append - see docs/decisions.md.
set -euo pipefail

# Upsert, not append-if-missing: a VM that gets rebuilt (see
# docs/decisions.md on hypervisor stalls) comes back with a new IP, and a
# plain "append if this exact line isn't already there" check left the
# OLD IP's line in place alongside the new one - two conflicting entries
# for the same hostname, undefined/first-match-wins resolution.
for entry in "WEB_IP_PLACEHOLDER web" "DB_IP_PLACEHOLDER db" "ATT_IP_PLACEHOLDER attacker"; do
  host="${entry##* }"
  sed -i "/[[:space:]]${host}\$/d" /etc/hosts
  echo "$entry" >> /etc/hosts
done
